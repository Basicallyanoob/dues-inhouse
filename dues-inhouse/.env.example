# Copy to .env.local for local development. On Vercel, set these under
# Project > Settings > Environment Variables instead. See README: Setting up.

# Postgres. Supabase: Connect > Transaction pooler (port 6543), password filled in.
# Not the "Direct connection" (db.<ref>.supabase.co): Vercel can't reach it.
# If the password has @ # / ? or % in it, URL-encode them (or pick a password without).
DATABASE_URL=

# Supabase project URL and publishable (anon) key: used only for Discord sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase secret (service_role) key: server-only, for uploading banner art.
SUPABASE_SERVICE_ROLE_KEY=

# Discord user ids that are always admins, separated by commas.
ADMIN_DISCORD_IDS=

# HenrikDev API key (HDEV-...) for the Valorant import and /link.
HENRIKDEV_API_KEY=
# Any long random text. The GitHub Actions schedule (and Vercel Cron) send it to /api/cron/*.
CRON_SECRET=

# Discord bot (Developer Portal > your application). Same application as the sign-in.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Right-click the server / channel > Copy ID (Developer Mode on).
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Optional
# DISCORD_LOG_CHANNEL_ID=       # Sunday import summary; default DISCORD_CHANNEL_ID
# WEEKLY_AUTO=1                 # 0: officers open sign-ups and make teams themselves
# WEEKLY_SIGNUPS_OPEN=17:00     # Saturday, Irish time
# WEEKLY_TEAMS_AT=18:45
# WEEKLY_VOTE_SECONDS=120
# WEEKLY_CHECKIN_SECONDS=300    # how long the check-in before each later game waits for answers
# WEEKLY_RANK_GAMES=8           # balancing: games after which rank and leaderboard rating count equally
# VAL_WINDOW=sat 18:30-03:30    # games must start inside this; "off" for any time
# VAL_PERF_WEIGHT=0.3           # performance moves a rating change by up to ±30%
# VAL_MARGIN_WEIGHT=0.2         # round margin: 13-11 moves ratings ~0.86x, 13-3 ~1.2x
# HENRIK_RATE_LIMIT=28          # HenrikDev requests a minute, site-wide (the key allows 30)
# MIN_GAMES_RANKED=5
# VAL_MIN_PLAYERS=10
# VAL_MIN_MEMBERS=3
# VAL_REGION=eu
# CLUB_TIME_ZONE=Europe/Dublin

# Local development only: sign in as anyone from /login. Ignored in production.
# DEV_LOGIN=1
