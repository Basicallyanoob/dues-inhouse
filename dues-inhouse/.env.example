# Copy to .env.local for local development. On Vercel, set these under
# Project > Settings > Environment Variables instead. See README: Setting up.

# Postgres. Supabase: Connect > Transaction pooler (port 6543), password filled in.
DATABASE_URL=

# Supabase project URL and publishable (anon) key: used only for Discord sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase secret (service_role) key: server-only, for uploading banner art.
SUPABASE_SERVICE_ROLE_KEY=

# Discord user ids that are always admins, separated by commas.
ADMIN_DISCORD_IDS=

# HenrikDev API key (HDEV-...) for the Valorant import.
HENRIKDEV_API_KEY=
# Any long random text; Vercel Cron sends it to /api/cron/valorant.
CRON_SECRET=

# Optional
# MIN_GAMES_RANKED=5
# VAL_MIN_PLAYERS=10
# VAL_MIN_MEMBERS=3
# VAL_REGION=eu
# CLUB_TIME_ZONE=Europe/Dublin

# Local development only: sign in as anyone from /login. Ignored in production.
# DEV_LOGIN=1
